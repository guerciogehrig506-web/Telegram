# ============================================
# Trio Backend - Production Environment
# ============================================
# Copy this file to .env and modify as needed

# Database (PostgreSQL)
DATABASE_URL="postgresql://trio:trio_secret_change_me@db:5432/trio"

# JWT
JWT_SECRET="trio-jwt-production-secret-change-me"
JWT_EXPIRES_IN="7d"

# Session
SESSION_SECRET="trio-session-production-secret-change-me"

# Admin
ADMIN_PASSWORD="change_me_admin_password"

# Server
PORT=3000