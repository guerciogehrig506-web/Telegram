<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trio Admin - 消息记录</title>
  <link rel="stylesheet" href="/admin/css/style.css">
</head>
<body>
  <%- include('partials/header', { admin, current: 'messages' }) %>
  <div class="admin-body">
    <%- include('partials/sidebar', { current: 'messages' }) %>
    <main class="content">
      <h2>消息记录</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>发送者</th>
            <th>接收者</th>
            <th>内容</th>
            <th>时间</th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach(function(m) { %>
            <tr>
              <td><%= m.sender?.username || '-' %></td>
              <td><%= m.receiver?.username || (m.groupId ? '群组' : '-') %></td>
              <td class="msg-content"><%= m.content %></td>
              <td><%= new Date(m.createdAt).toLocaleString('zh-CN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>