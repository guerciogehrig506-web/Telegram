<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trio Admin - 用户管理</title>
  <link rel="stylesheet" href="/admin/css/style.css">
</head>
<body>
  <%- include('partials/header', { admin, current: 'users' }) %>
  <div class="admin-body">
    <%- include('partials/sidebar', { current: 'users' }) %>
    <main class="content">
      <h2>用户管理</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>用户名</th>
            <th>邮箱</th>
            <th>角色</th>
            <th>部门</th>
            <th>状态</th>
            <th>注册时间</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.username %></td>
              <td><%= u.email %></td>
              <td><span class="badge <%= u.role === 'ADMIN' ? 'badge-admin' : 'badge-user' %>"><%= u.role %></span></td>
              <td><%= u.department || '-' %></td>
              <td><span class="badge <%= u.isActive ? 'badge-active' : 'badge-inactive' %>"><%= u.isActive ? '在线' : '离线' %></span></td>
              <td><%= new Date(u.createdAt).toLocaleString('zh-CN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>